<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="980" d:DesignHeight="900"
             x:Class="Heron.ClientControls.Gallery.Pages.PopupComparisonPage">

  <!-- 使用通用 Semi 弹出模板；不引用宿主或业务视图。 -->
  <UserControl.Styles>
    <Style Selector="Border.ruleCard">
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="#D7E0EA" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="18" />
    </Style>
    <Style Selector="Border.demoSlot">
      <Setter Property="Background" Value="#F8FAFC" />
      <Setter Property="BorderBrush" Value="#E2E8F0" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="16" />
    </Style>
    <Style Selector="Border.snippetBlock">
      <Setter Property="Background" Value="#0F172A" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="12,10" />
    </Style>
    <Style Selector="SelectableTextBlock.snippetText">
      <Setter Property="FontFamily" Value="Cascadia Mono,Consolas,monospace" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="LineHeight" Value="18" />
      <Setter Property="Foreground" Value="#E2E8F0" />
    </Style>
    <Style Selector="TextBlock.ruleTag">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#247C86" />
    </Style>
    <Style Selector="TextBlock.doDont">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
  </UserControl.Styles>

  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="24,20" Spacing="22" MaxWidth="920" HorizontalAlignment="Left">

      <StackPanel Spacing="5">
        <TextBlock FontSize="22" FontWeight="SemiBold" Text="Popup 弹出层规范" />
        <TextBlock Foreground="#64748B" TextWrapping="Wrap"
                   Text="四种弹出语义统一使用 Semi.Avalonia 原生控件，不做模板替换。每组给出规则、标准样例（可直接照抄）和常见误用。空数据态是唯一需要额外套用样式类的场景，用法见第 2 组。" />
      </StackPanel>

      <!-- 1. 选择型 -->
      <Border Classes="ruleCard">
        <StackPanel Spacing="12">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Classes="ruleTag" Text="选择型" />
            <TextBlock Foreground="#94A3B8" FontSize="11" Text="ComboBox · Workspace / 地图 / 设备等单选场景" />
          </StackPanel>
          <Border Classes="demoSlot">
            <StackPanel Spacing="8">
              <ComboBox Classes="dropdownStretch" HorizontalAlignment="Stretch" PlaceholderText="请选择工作区">
                <ComboBoxItem Content="sample-workspace" />
                <ComboBoxItem Content="sample-workspace-dev" />
                <ComboBoxItem Content="sample-workspace-long-name" />
              </ComboBox>
            </StackPanel>
          </Border>
          <StackPanel Spacing="4">
            <TextBlock Classes="doDont" Text="✓ 规则：所有单选下拉统一加 Classes=&quot;dropdownStretch&quot;（内容左对齐、占满宽度），不要依赖 Semi 默认行为——自定义 ItemTemplate（带徽标、副标题等复合内容）时默认对齐会跟着内容走，不加这个类会出现有的页面左对齐、有的页面居中的不一致。" />
            <TextBlock Classes="doDont" Text="✓ 规则：靠近窗口/面板底部时无需处理，ComboBox 的下拉定位是 Avalonia 内置能力，会自动向上展开（见第 4 组验证）。" />
          </StackPanel>
          <Border Classes="snippetBlock">
            <SelectableTextBlock Classes="snippetText" Text="&lt;ComboBox Classes=&quot;dropdownStretch&quot; ItemsSource=&quot;{Binding Workspaces}&quot; SelectedItem=&quot;{Binding SelectedWorkspace}&quot; DisplayMemberBinding=&quot;{Binding Name}&quot; /&gt;" />
          </Border>
        </StackPanel>
      </Border>

      <!-- 2. 空数据态 -->
      <Border Classes="ruleCard">
        <StackPanel Spacing="12">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Classes="ruleTag" Text="空数据态" />
            <TextBlock Foreground="#94A3B8" FontSize="11" Text="ComboBox.emptyState · ItemsSource 为空时的标准表现" />
          </StackPanel>
          <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
            <Border Grid.Column="0" Classes="demoSlot">
              <StackPanel Spacing="8">
                <TextBlock Classes="ruleTag" Foreground="#DC2626" Text="✗ 现状（禁止）" />
                <ComboBox HorizontalAlignment="Stretch" PlaceholderText="请选择调试设备" />
                <TextBlock Classes="doDont" Foreground="#DC2626"
                           Text="点击后弹出一个空白框，没有任何提示。不要让 ComboBox 在无数据时保持可点击的默认外观。" />
              </StackPanel>
            </Border>
            <Border Grid.Column="1" Classes="demoSlot">
              <StackPanel Spacing="8">
                <TextBlock Classes="ruleTag" Text="✓ 标准（emptyState）" />
                <ComboBox Classes="emptyState" HorizontalAlignment="Stretch" IsEnabled="False"
                          PlaceholderText="暂无可选设备，请确认已连接 USB 调试设备" />
                <TextBlock Classes="doDont" Text="禁用态视觉采用细边框、低对比度、浅底色（借鉴 SukiUI 的轻量禁用质感，比 Semi 默认深灰更柔和），与“业务逻辑原因禁用”区分开；PlaceholderText 直接说明原因，不需要额外提示行。" />
              </StackPanel>
            </Border>
          </Grid>
          <StackPanel Spacing="4">
            <TextBlock Classes="doDont" Text="✓ 规则：业务在 ViewModel 里判断数据源是否为空（如 HasDevices），为空时 IsEnabled 绑同一个条件，并加 Classes=&quot;emptyState&quot;；PlaceholderText 写清楚“为什么没有”而不是泛泛的“请选择”。" />
          </StackPanel>
          <Border Classes="snippetBlock">
            <SelectableTextBlock Classes="snippetText" TextWrapping="Wrap"
                                  Text="&lt;ComboBox Classes=&quot;dropdownStretch emptyState&quot; ItemsSource=&quot;{Binding Devices}&quot; SelectedItem=&quot;{Binding SelectedDevice}&quot; IsEnabled=&quot;{Binding HasDevices}&quot; PlaceholderText=&quot;{Binding EmptyDeviceHint}&quot; /&gt;&#10;&#10;// ViewModel&#10;public bool HasDevices =&gt; Devices.Count &gt; 0;&#10;public string EmptyDeviceHint =&gt; &quot;暂无可选设备，请确认已连接 USB 调试设备&quot;;" />
          </Border>
        </StackPanel>
      </Border>

      <!-- 3. 信息展示型 -->
      <Border Classes="ruleCard">
        <StackPanel Spacing="12">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Classes="ruleTag" Text="信息展示型" />
            <TextBlock Foreground="#94A3B8" FontSize="11" Text="Button.Flyout · 只读信息卡，对应 Workspace 详情等" />
          </StackPanel>
          <Border Classes="demoSlot">
            <StackPanel Spacing="8">
              <Button Content="Workspace 详情 ▾" Classes="contentButton buttonSecondary buttonSmall" HorizontalAlignment="Left">
                <Button.Flyout>
                  <Flyout Placement="Bottom">
                    <Border Width="380" Padding="16">
                      <StackPanel Spacing="10">
                        <TextBlock FontWeight="SemiBold" Text="运行环境" />
                        <TextBlock Text="sample-workspace · /example/data"
                                   Foreground="#1769E0" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="Root: C:\p4" FontFamily="Cascadia Mono,Consolas,monospace" FontSize="12" />
                      </StackPanel>
                    </Border>
                  </Flyout>
                </Button.Flyout>
              </Button>
            </StackPanel>
          </Border>
          <StackPanel Spacing="4">
            <TextBlock Classes="doDont" Text="✓ 规则：内容用纵向 StackPanel 排列，天然左对齐，不需要额外设置。宽度按内容定死（常规信息卡 360-440px），不要用 Stretch 让宽度随窗口变化。" />
            <TextBlock Classes="doDont" Text="✓ 规则：显式写 Placement=&quot;Bottom&quot;，不要写 BottomEdgeAlignedLeft/Right 这类固定死角的枚举——固定角在窄窗口下容易超出边界，Bottom 让 Avalonia 有调整空间。" />
            <TextBlock Classes="doDont" Text="⚠ 注意：Flyout 没有 ComboBox 那种自动上翻能力，页面底部的触发按钮如果面板可能超出窗口，需要业务自行判断改用 Top（见第 4 组）。" />
          </StackPanel>
          <Border Classes="snippetBlock">
            <SelectableTextBlock Classes="snippetText" TextWrapping="Wrap"
                                  Text="&lt;Button Content=&quot;Workspace 详情 ▾&quot; Classes=&quot;contentButton buttonSecondary buttonSmall&quot;&gt;&#10;  &lt;Button.Flyout&gt;&#10;    &lt;Flyout Placement=&quot;Bottom&quot;&gt;&#10;      &lt;Border Width=&quot;380&quot; Padding=&quot;16&quot;&gt;&#10;        &lt;StackPanel Spacing=&quot;10&quot;&gt;...&lt;/StackPanel&gt;&#10;      &lt;/Border&gt;&#10;    &lt;/Flyout&gt;&#10;  &lt;/Button.Flyout&gt;&#10;&lt;/Button&gt;" />
          </Border>
        </StackPanel>
      </Border>

      <!-- 4. 输入建议型 -->
      <Border Classes="ruleCard">
        <StackPanel Spacing="12">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Classes="ruleTag" Text="输入建议型" />
            <TextBlock Foreground="#94A3B8" FontSize="11" Text="AutoCompleteBox · 可编辑 + 联想下拉，对应引擎路径选择" />
          </StackPanel>
          <Border Classes="demoSlot">
            <StackPanel Spacing="8">
              <AutoCompleteBox x:Name="EnginePathAutoComplete" PlaceholderText="点击输入框选择本机已注册的引擎目录"
                               HorizontalAlignment="Stretch" FilterMode="Contains" />
            </StackPanel>
          </Border>
          <StackPanel Spacing="4">
            <TextBlock Classes="doDont" Text="✓ 规则：新增“可输入 + 候选建议”场景统一用 AutoCompleteBox，不要再手写 Popup + TextBox + ListBox 组合（现有 EditablePathPicker 属于历史实现，后续可评估迁移，不在本次规范范围内新增同类手写控件）。" />
            <TextBlock Classes="doDont" Text="✓ 规则：FilterMode 统一用 Contains（子串匹配），比默认 StartsWith 更符合路径/名称的模糊查找习惯。" />
          </StackPanel>
          <Border Classes="snippetBlock">
            <SelectableTextBlock Classes="snippetText" TextWrapping="Wrap"
                                  Text="&lt;AutoCompleteBox PlaceholderText=&quot;点击输入框选择本机已注册的引擎目录&quot; ItemsSource=&quot;{Binding EnginePathSuggestions}&quot; FilterMode=&quot;Contains&quot; Text=&quot;{Binding EnginePath}&quot; /&gt;" />
          </Border>
        </StackPanel>
      </Border>

      <!-- 5. 底部翻转行为 -->
      <Border Classes="ruleCard">
        <StackPanel Spacing="12">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Classes="ruleTag" Text="底部翻转行为" />
            <TextBlock Foreground="#94A3B8" FontSize="11" Text="把窗口拉矮，或滚动到底部再展开，验证两者差异" />
          </StackPanel>
          <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
            <Border Grid.Column="0" Classes="demoSlot">
              <StackPanel Spacing="8">
                <TextBlock Classes="ruleTag" Text="ComboBox（自动上翻，无需处理）" />
                <ComboBox Classes="dropdownStretch" HorizontalAlignment="Stretch" PlaceholderText="靠近底部展开试试">
                  <ComboBoxItem Content="Map015" />
                  <ComboBoxItem Content="OrkneyIslands" />
                  <ComboBoxItem Content="SampleComponent_08" />
                  <ComboBoxItem Content="选项 4" />
                  <ComboBoxItem Content="选项 5" />
                </ComboBox>
              </StackPanel>
            </Border>
            <Border Grid.Column="1" Classes="demoSlot">
              <StackPanel Spacing="8">
                <TextBlock Classes="ruleTag" Text="Flyout（不会自动上翻，需业务判断）" />
                <Button Content="打开信息面板 ▾" Classes="contentButton buttonSecondary buttonMedium"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                  <Button.Flyout>
                    <Flyout Placement="Bottom">
                      <Border Width="280" Padding="12">
                        <TextBlock Text="固定向下展开；若窗口底部空间不足，此面板会被裁切或强制贴边，不会像 ComboBox 一样跳到按钮上方。"
                                   TextWrapping="Wrap" />
                      </Border>
                    </Flyout>
                  </Button.Flyout>
                </Button>
              </StackPanel>
            </Border>
          </Grid>
          <TextBlock Classes="doDont"
                     Text="✓ 规则：选择型控件优先用 ComboBox 而不是自定义 Flyout + ListBox，可以直接省掉翻转适配的心智负担。若业务场景必须用 Flyout 且触发按钮可能贴近容器底部（如页面底部工具栏），需要业务自行按容器位置切换 Placement=&quot;Top&quot;，规范层面不做自动化处理。" />
        </StackPanel>
      </Border>

      <Border Padding="24" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
