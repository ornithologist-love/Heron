<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Heron.ClientFramework.Shell</PackageId>
    <AssemblyName>Heron.ClientFramework.Shell</AssemblyName>
    <RootNamespace>Heron.ClientFramework.Shell</RootNamespace>
    <Description>Business-free host shell: ShellWindow (title bar, sidebar, user menu, footer), plugin-scoped presentation, plugin page hosting and sidebar navigation.</Description>
    <IsPackable>true</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../ClientFramework.Runtime/Heron.ClientFramework.Runtime.csproj" />
    <ProjectReference Include="../ClientFramework.Infrastructure/Heron.ClientFramework.Infrastructure.csproj" />
    <ProjectReference Include="../Client.Controls/Heron.ClientControls.csproj" />
    <PackageReference Include="Avalonia" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="FluentIcons.Avalonia" />
    <PackageReference Include="Serilog" />
  </ItemGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>
</Project>
