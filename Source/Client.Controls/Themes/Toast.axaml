<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:fi="using:FluentIcons.Avalonia"
                    xmlns:toast="using:Heron.ClientControls.Notifications">
  <x:Double x:Key="ToastMaximumWidth">420</x:Double>

  <ControlTheme x:Key="{x:Type toast:ToastHost}" TargetType="toast:ToastHost">
    <Setter Property="Margin" Value="16" />
    <Setter Property="MaxWidth" Value="{DynamicResource ToastMaximumWidth}" />
    <Setter Property="IsHitTestVisible" Value="True" />
    <Setter Property="ItemsPanel">
      <ItemsPanelTemplate>
        <StackPanel Spacing="2" />
      </ItemsPanelTemplate>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate>
        <ItemsPresenter HorizontalAlignment="Stretch" />
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type toast:ToastCard}" TargetType="toast:ToastCard">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border x:Name="PART_Card"
                Margin="0,4"
                Padding="10,8,8,8"
                HorizontalAlignment="Stretch"
                Background="{DynamicResource BgSurfaceBrush}"
                BorderBrush="{DynamicResource BorderDefaultBrush}"
                BorderThickness="1"
                BoxShadow="0 8 24 0 #2B0F172A"
                CornerRadius="12"
                ClipToBounds="True">
          <Grid RowDefinitions="Auto,3" RowSpacing="6">
            <Grid ColumnDefinitions="28,*,Auto" ColumnSpacing="8">
              <Border Width="28" Height="28"
                      VerticalAlignment="Top"
                      Background="{TemplateBinding AccentBackground}"
                      CornerRadius="14">
                <TextBlock HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="16"
                           FontWeight="Bold"
                           Foreground="{TemplateBinding AccentBrush}"
                           Text="{TemplateBinding IconText}" />
              </Border>

              <StackPanel Grid.Column="1" MinWidth="0" Spacing="3" VerticalAlignment="Center">
                <TextBlock FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           Text="{TemplateBinding Title}"
                           TextWrapping="Wrap" />
                <ScrollViewer MaxHeight="96"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                  <TextBlock FontSize="13"
                             LineHeight="19"
                             Foreground="{DynamicResource FgSecondaryBrush}"
                             Text="{TemplateBinding Message}"
                             TextWrapping="Wrap" />
                </ScrollViewer>
              </StackPanel>

              <Button x:Name="PART_CloseButton"
                      Grid.Column="2"
                      Width="24" Height="24"
                      MinWidth="0" MinHeight="0"
                      Padding="0"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Top"
                      Background="Transparent"
                      BorderBrush="Transparent"
                      CornerRadius="6"
                      Cursor="Hand"
                      IsVisible="{TemplateBinding ShowCloseButton}"
                      ToolTip.Tip="关闭通知">
                <fi:FluentIcon HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource FgMetaBrush}"
                               Icon="Dismiss"
                               IconSize="Size16" />
              </Button>
            </Grid>

            <ProgressBar Grid.Row="1"
                         Height="3"
                         Margin="-10,0,-8,-8"
                         Maximum="1"
                         Minimum="0"
                         Foreground="{TemplateBinding AccentBrush}"
                         IsVisible="{TemplateBinding IsTimed}"
                         Value="{TemplateBinding DismissProgress}" />
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>
