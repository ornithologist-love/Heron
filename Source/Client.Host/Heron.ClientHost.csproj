<Project Sdk="Microsoft.NET.Sdk">
  <!-- Minimal Heron shell launcher: ShellWindow + plugin host, no product identity, sign-in or business services. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>Heron.ClientHost</AssemblyName>
    <RootNamespace>Heron.ClientHost</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/heron-filled.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <BaseOutputPath>$(MSBuildThisFileDirectory)../../../Binaries/Heron/ClientHost/</BaseOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../ClientFramework.Desktop/Heron.ClientFramework.Desktop.csproj" />
    <ProjectReference Include="../Pregel.Avalonia/Heron.Pregel.Avalonia.csproj" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="Avalonia.Headless" />
    <PackageReference Include="Semi.Avalonia" />
    <PackageReference Include="Semi.Avalonia.DataGrid" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <AvaloniaResource Include="Assets/heron-avatar.png" />
    <None Update="host-api.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
