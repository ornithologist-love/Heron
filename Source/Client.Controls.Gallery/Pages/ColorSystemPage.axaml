<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fi="using:FluentIcons.Avalonia"
             x:Class="Heron.ClientControls.Gallery.Pages.ColorSystemPage">
  <!--
    色彩规范页（Jade 软玉方向）。所有颜色只引用 ColorTokens.axaml 中的语义 Token。
    本页的 spec* 样式是"新规范预览"，生产页面迁移前 HeronTheme 中的 button* 仍保持旧外观；
    迁移时把 button* 指向同一组语义 Token，即可与本页一致。
  -->
  <UserControl.Styles>
    <Style Selector="Border.section">
      <Setter Property="Background" Value="{DynamicResource BgSurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="20" />
    </Style>
    <Style Selector="Border.slot">
      <Setter Property="Background" Value="{DynamicResource BgSurfaceSubtleBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="14" />
    </Style>
    <Style Selector="TextBlock.h1">
      <Setter Property="FontSize" Value="22" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource FgPrimaryBrush}" />
    </Style>
    <Style Selector="TextBlock.h2">
      <Setter Property="FontSize" Value="16" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource FgPrimaryBrush}" />
    </Style>
    <Style Selector="TextBlock.h3">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource FgPrimaryBrush}" />
    </Style>
    <Style Selector="TextBlock.body">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="LineHeight" Value="20" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Foreground" Value="{DynamicResource FgDefaultBrush}" />
    </Style>
    <Style Selector="TextBlock.note">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="LineHeight" Value="18" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Foreground" Value="{DynamicResource FgSecondaryBrush}" />
    </Style>
    <Style Selector="TextBlock.meta">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{DynamicResource FgMetaBrush}" />
    </Style>
    <Style Selector="TextBlock.code">
      <Setter Property="FontFamily" Value="Cascadia Mono,Consolas,monospace" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource FgDefaultBrush}" />
    </Style>

    <!-- ===== 按钮（新规范预览） ===== -->
    <Style Selector="Button.spec">
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="Padding" Value="14,7" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.spec.small">
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="Padding" Value="10,5" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="Button.spec.large">
      <Setter Property="MinHeight" Value="40" />
      <Setter Property="Padding" Value="20,8" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="Button.spec.primary /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource FgOnAccentBrush}" />
    </Style>
    <Style Selector="Button.spec.primary:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource FgOnAccentBrush}" />
    </Style>
    <Style Selector="Button.spec.primary:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentPressedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentPressedBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource FgOnAccentBrush}" />
    </Style>

    <Style Selector="Button.spec.secondary /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource BgSurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource FgDefaultBrush}" />
    </Style>
    <Style Selector="Button.spec.secondary:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource BgHoverBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource FgDefaultBrush}" />
    </Style>
    <Style Selector="Button.spec.secondary:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource BgPressedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource FgDefaultBrush}" />
    </Style>

    <Style Selector="Button.spec.quiet /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource BgSurfaceSubtleBrush}" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource FgDefaultBrush}" />
    </Style>
    <Style Selector="Button.spec.quiet:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource BgHoverBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource FgDefaultBrush}" />
    </Style>
    <Style Selector="Button.spec.quiet:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource BgPressedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource FgDefaultBrush}" />
    </Style>

    <Style Selector="Button.spec.danger /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource DangerBgBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource DangerBorderBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource DangerFgBrush}" />
    </Style>
    <Style Selector="Button.spec.danger:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource DangerBgHoverBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource DangerBorderBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource DangerFgBrush}" />
    </Style>
    <Style Selector="Button.spec.danger:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource DangerBorderBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource DangerBorderBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource DangerFgBrush}" />
    </Style>

    <Style Selector="Button.spec.link">
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="4,2" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.spec.link /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource FgLinkBrush}" />
    </Style>
    <Style Selector="Button.spec.link:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource AccentHoverBrush}" />
    </Style>
    <Style Selector="Button.spec.link:pointerover TextBlock">
      <Setter Property="TextDecorations" Value="Underline" />
    </Style>

    <Style Selector="Button.spec:focus-visible /template/ ContentPresenter">
      <Setter Property="BorderBrush" Value="{DynamicResource BorderFocusBrush}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="Button.spec:disabled /template/ ContentPresenter">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="Background" Value="{DynamicResource BgDisabledBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource FgDisabledBrush}" />
    </Style>
    <Style Selector="Button.spec.link:disabled /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <!-- ===== 状态徽标 / 圆点 ===== -->
    <Style Selector="Border.badge">
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="Padding" Value="8,3" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style Selector="Border.badge TextBlock">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <!-- 徽标内图标：IconSize 枚举会给 20px 盒子，这里用 FontSize 精确到 14px 盒 / 12px 字形，与 12px 文字等高居中 -->
    <Style Selector="fi|FluentIcon.badgeIcon">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="IconVariant" Value="Filled" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.badge.success">
      <Setter Property="Background" Value="{DynamicResource SuccessBgBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SuccessBorderBrush}" />
    </Style>
    <Style Selector="Border.badge.success TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource SuccessFgBrush}" />
    </Style>
    <Style Selector="Border.badge.info">
      <Setter Property="Background" Value="{DynamicResource InfoBgBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource InfoBorderBrush}" />
    </Style>
    <Style Selector="Border.badge.info TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource InfoFgBrush}" />
    </Style>
    <Style Selector="Border.badge.warning">
      <Setter Property="Background" Value="{DynamicResource WarningBgBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource WarningBorderBrush}" />
    </Style>
    <Style Selector="Border.badge.warning TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource WarningFgBrush}" />
    </Style>
    <Style Selector="Border.badge.danger">
      <Setter Property="Background" Value="{DynamicResource DangerBgBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource DangerBorderBrush}" />
    </Style>
    <Style Selector="Border.badge.danger TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource DangerFgBrush}" />
    </Style>
    <Style Selector="Border.badge.neutral">
      <Setter Property="Background" Value="{DynamicResource NeutralStatusBgBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource NeutralStatusBorderBrush}" />
    </Style>
    <Style Selector="Border.badge.neutral TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource NeutralStatusFgBrush}" />
    </Style>
    <Style Selector="Border.badge.solidDanger">
      <Setter Property="Background" Value="{DynamicResource DangerSolidBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource DangerSolidBrush}" />
    </Style>
    <Style Selector="Border.badge.solidDanger TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource FgOnAccentBrush}" />
    </Style>

    <Style Selector="Ellipse.dot">
      <Setter Property="Width" Value="8" />
      <Setter Property="Height" Value="8" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Ellipse.dot.success"><Setter Property="Fill" Value="{DynamicResource SuccessIconBrush}" /></Style>
    <Style Selector="Ellipse.dot.info"><Setter Property="Fill" Value="{DynamicResource InfoIconBrush}" /></Style>
    <Style Selector="Ellipse.dot.warning"><Setter Property="Fill" Value="{DynamicResource WarningIconBrush}" /></Style>
    <Style Selector="Ellipse.dot.danger"><Setter Property="Fill" Value="{DynamicResource DangerIconBrush}" /></Style>
    <Style Selector="Ellipse.dot.neutral"><Setter Property="Fill" Value="{DynamicResource NeutralStatusIconBrush}" /></Style>

    <!-- ===== 导航方案 A ===== -->
    <Style Selector="Border.navItem">
      <Setter Property="Height" Value="40" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Margin" Value="6,2" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Border.navItem:pointerover">
      <Setter Property="Background" Value="{DynamicResource NavHoverBgBrush}" />
    </Style>
    <Style Selector="Border.navItem.selected">
      <Setter Property="Background" Value="{DynamicResource NavSelectedBgBrush}" />
    </Style>
    <Style Selector="Border.navItem TextBlock">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource NavFgBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.navItem.selected TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource NavSelectedFgBrush}" />
    </Style>
    <Style Selector="Border.navItem fi|FluentIcon">
      <Setter Property="Foreground" Value="{DynamicResource NavIconBrush}" />
      <Setter Property="IconVariant" Value="Filled" />
      <Setter Property="IconSize" Value="Size20" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.navItem.selected fi|FluentIcon">
      <Setter Property="Foreground" Value="{DynamicResource NavSelectedIconBrush}" />
    </Style>
    <Style Selector="Border.navItem Border.indicator">
      <Setter Property="Width" Value="3" />
      <Setter Property="Height" Value="18" />
      <Setter Property="CornerRadius" Value="2" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Border.navItem.selected Border.indicator">
      <Setter Property="Background" Value="{DynamicResource NavIndicatorBrush}" />
    </Style>

    <!-- ===== 工作区卡片（选中归蓝色） ===== -->
    <Style Selector="Border.workspaceCard">
      <Setter Property="Background" Value="{DynamicResource BgSurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="12,10" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Border.workspaceCard:pointerover">
      <Setter Property="Background" Value="{DynamicResource BgHoverBrush}" />
    </Style>
    <Style Selector="Border.workspaceCard.selected">
      <Setter Property="Background" Value="{DynamicResource BgSelectedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderSelectedBrush}" />
    </Style>
  </UserControl.Styles>

  <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{DynamicResource BgContentBrush}">
    <StackPanel Margin="28,22" Spacing="18" MaxWidth="1040" HorizontalAlignment="Left">

      <!-- 页头 -->
      <StackPanel Spacing="6">
        <TextBlock Classes="h1" Text="色彩规范 · Jade 软玉" />
        <TextBlock Classes="note"
                   Text="Token 定义在 Client.Controls/Themes/ColorTokens.axaml。色阶、语义 Token 与对比度表格均从资源字典实时读取并计算；修改 Token 后重启 Gallery 即可核对。页面只允许引用语义 Token，禁止写死色值。" />
      </StackPanel>

      <!-- 1. 颜色职责 -->
      <Border Classes="section">
        <StackPanel Spacing="14">
          <TextBlock Classes="h2" Text="1 · 颜色职责" />
          <UniformGrid Columns="4">
            <Border Margin="0,0,10,0" CornerRadius="8" Padding="14" Background="{DynamicResource BgAppBrush}"
                    BorderBrush="{DynamicResource BrandDividerBrush}" BorderThickness="1">
              <StackPanel Spacing="6">
                <TextBlock Classes="h3" Foreground="{DynamicResource FgOnJadeBrush}" Text="Jade 玉色" />
                <TextBlock Classes="note" Text="侧栏、品牌区域、柔和背景层次。不承担操作和状态。" />
              </StackPanel>
            </Border>
            <Border Margin="0,0,10,0" CornerRadius="8" Padding="14" Background="{DynamicResource BgSurfaceBrush}"
                    BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1">
              <StackPanel Spacing="6">
                <TextBlock Classes="h3" Text="Neutral 中性" />
                <TextBlock Classes="note" Text="正文、辅助文字、内容背景、边框、分隔线。正文保持清晰灰黑。" />
              </StackPanel>
            </Border>
            <Border Margin="0,0,10,0" CornerRadius="8" Padding="14" Background="{DynamicResource AccentSubtleBrush}"
                    BorderBrush="{DynamicResource InfoBorderBrush}" BorderThickness="1">
              <StackPanel Spacing="6">
                <TextBlock Classes="h3" Foreground="{DynamicResource FgLinkBrush}" Text="Blue 操作" />
                <TextBlock Classes="note" Text="主操作、链接、焦点、选中。每个操作组最多一个蓝色实心按钮。" />
              </StackPanel>
            </Border>
            <Border CornerRadius="8" Padding="14" Background="{DynamicResource BgSurfaceBrush}"
                    BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1">
              <StackPanel Spacing="6">
                <TextBlock Classes="h3" Text="语义状态" />
                <WrapPanel>
                  <Border Classes="badge success" Margin="0,0,4,4"><TextBlock Text="成功" /></Border>
                  <Border Classes="badge info" Margin="0,0,4,4"><TextBlock Text="信息" /></Border>
                  <Border Classes="badge warning" Margin="0,0,4,4"><TextBlock Text="警告" /></Border>
                  <Border Classes="badge danger" Margin="0,0,4,4"><TextBlock Text="危险" /></Border>
                </WrapPanel>
                <TextBlock Classes="note" Text="只用于有明确业务含义的状态反馈。" />
              </StackPanel>
            </Border>
          </UniformGrid>
        </StackPanel>
      </Border>

      <!-- 2. 原始色阶 -->
      <Border Classes="section">
        <StackPanel Spacing="16">
          <StackPanel Spacing="4">
            <TextBlock Classes="h2" Text="2 · 原始色阶" />
            <TextBlock Classes="note" Text="只定义有哪些颜色，不表达用途；页面禁止直接引用 *Color。色块上的数字是色阶，下方为色值与白底对比度。" />
          </StackPanel>
          <StackPanel x:Name="ScalePanel" Spacing="18" />
        </StackPanel>
      </Border>

      <!-- 3. 语义 Token -->
      <Border Classes="section">
        <StackPanel Spacing="12">
          <StackPanel Spacing="4">
            <TextBlock Classes="h2" Text="3 · 语义 Token" />
            <TextBlock Classes="note" Text="页面只引用这一层。列依次为：色块、Key、来源色阶、实际色值、用途。" />
          </StackPanel>
          <StackPanel x:Name="SemanticPanel" Spacing="14" />
        </StackPanel>
      </Border>

      <!-- 4. 对比度 -->
      <Border Classes="section">
        <StackPanel Spacing="12">
          <StackPanel Spacing="4">
            <TextBlock Classes="h2" Text="4 · 对比度校验（WCAG AA）" />
            <TextBlock Classes="note" Text="按前景 + 背景成对检查：正文 ≥ 4.5，图形和元信息 ≥ 3，禁用文字豁免。新增 Token 组合时在 ColorSystemPage.axaml.cs 的 Pairs 中登记。" />
          </StackPanel>
          <StackPanel x:Name="PairPanel" />
        </StackPanel>
      </Border>

      <!-- 5. 按钮 -->
      <Border Classes="section">
        <StackPanel Spacing="14">
          <StackPanel Spacing="4">
            <TextBlock Classes="h2" Text="5 · 按钮" />
            <TextBlock Classes="note" Text="本节为新规范预览（可悬停、按下、Tab 聚焦）。buttonSuccess 绿色执行按钮在快速启动中改为 Primary；绿色只留给成功状态。" />
          </StackPanel>

          <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="10">
            <TextBlock Classes="h3" Text="Primary" VerticalAlignment="Center" />
            <WrapPanel Grid.Column="1">
              <Button Classes="spec primary large" Margin="0,0,8,0">
                <StackPanel Orientation="Horizontal" Spacing="7">
                  <fi:FluentIcon Icon="ArrowSync" IconSize="Size16" />
                  <TextBlock Text="立即同步" />
                </StackPanel>
              </Button>
              <Button Classes="spec primary" Margin="0,0,8,0" Content="检查更新" />
              <Button Classes="spec primary small" Margin="0,0,8,0" Content="应用" />
              <Button Classes="spec primary" Content="禁用" IsEnabled="False" />
            </WrapPanel>

            <TextBlock Grid.Row="1" Classes="h3" Text="Secondary" VerticalAlignment="Center" />
            <WrapPanel Grid.Row="1" Grid.Column="1">
              <Button Classes="spec secondary" Margin="0,0,8,0">
                <StackPanel Orientation="Horizontal" Spacing="7">
                  <fi:FluentIcon Icon="Open" IconSize="Size16" />
                  <TextBlock Text="查看详情" />
                </StackPanel>
              </Button>
              <Button Classes="spec secondary small" Margin="0,0,8,0" Content="项目目录" />
              <Button Classes="spec secondary small" Margin="0,0,8,0" Content="日志目录" />
              <Button Classes="spec secondary small" Margin="0,0,8,0" Content="崩溃目录" />
              <Button Classes="spec secondary small" Content="禁用" IsEnabled="False" />
            </WrapPanel>

            <TextBlock Grid.Row="2" Classes="h3" Text="Quiet" VerticalAlignment="Center" />
            <WrapPanel Grid.Row="2" Grid.Column="1">
              <Button Classes="spec quiet small" Margin="0,0,8,0" Content="恢复默认排序" />
              <Button Classes="spec quiet small" Margin="0,0,8,0">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <fi:FluentIcon Icon="ArrowClockwise" IconSize="Size16" />
                  <TextBlock Text="刷新列表" />
                </StackPanel>
              </Button>
              <Button Classes="spec quiet small" Content="收起" />
            </WrapPanel>

            <TextBlock Grid.Row="3" Classes="h3" Text="Danger" VerticalAlignment="Center" />
            <WrapPanel Grid.Row="3" Grid.Column="1">
              <Button Classes="spec danger" Margin="0,0,8,0">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <fi:FluentIcon Icon="Stop" IconSize="Size16" />
                  <TextBlock Text="停止任务" />
                </StackPanel>
              </Button>
              <Button Classes="spec danger small" Margin="0,0,8,0" Content="强制覆盖所选范围" />
              <Button Classes="spec danger" Content="删除工作区" IsEnabled="False" />
            </WrapPanel>

            <TextBlock Grid.Row="4" Classes="h3" Text="Link" VerticalAlignment="Center" />
            <WrapPanel Grid.Row="4" Grid.Column="1">
              <Button Classes="spec link" Margin="0,0,12,0"><TextBlock Text="在线使用文档" /></Button>
              <TextBlock Classes="note" VerticalAlignment="Center" Text="仅用于跳转外部页面 / 文档。“任务详情”“节点日志”等应用内操作一律用 Secondary 或 Quiet。" />
            </WrapPanel>

            <Border Grid.Row="5" Grid.ColumnSpan="2" Classes="slot" Margin="0,4,0,0">
              <StackPanel Spacing="4">
                <TextBlock Classes="body" Text="· 一个 Card 或操作组最多一个 Primary；其余用 Secondary 或 Quiet。" />
                <TextBlock Classes="body" Text="· Danger 只用于停止、删除、强制覆盖等不可逆操作；“崩溃目录”只是打开文件夹，用 Secondary。" />
                <TextBlock Classes="body" Text="· 不再使用绿色实心按钮：立即同步、检查更新、应用配置等执行型操作改为 Primary。" />
                <TextBlock Classes="body" Text="· 实心红色只出现在二次确认弹窗的最终确认按钮。" />
                <TextBlock Classes="body" Text="· Link 只用于真正的超链接（打开网页、文档）；应用内操作不用 Link。" />
              </StackPanel>
            </Border>
          </Grid>
        </StackPanel>
      </Border>

      <!-- 6. 状态 -->
      <Border Classes="section">
        <StackPanel Spacing="14">
          <StackPanel Spacing="4">
            <TextBlock Classes="h2" Text="6 · 状态徽标与圆点" />
            <TextBlock Classes="note" Text="状态的业务含义本轮不调整，只把色值统一收进 Token：每种语义一组 Fg / Icon / Bg / Border。成功状态必须配图标或文字，不只靠颜色。" />
          </StackPanel>

          <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="12">
            <TextBlock Classes="h3" Text="浅底徽标" VerticalAlignment="Center" />
            <WrapPanel Grid.Column="1">
              <Border Classes="badge success" Margin="0,0,8,0">
                <StackPanel Orientation="Horizontal" Spacing="5">
                  <fi:FluentIcon Classes="badgeIcon" Icon="CheckmarkCircle" Foreground="{DynamicResource SuccessIconBrush}" />
                  <TextBlock Text="进程运行中" />
                </StackPanel>
              </Border>
              <Border Classes="badge info" Margin="0,0,8,0"><TextBlock Text="同步中" /></Border>
              <Border Classes="badge warning" Margin="0,0,8,0"><TextBlock Text="配置待修正" /></Border>
              <Border Classes="badge danger" Margin="0,0,8,0"><TextBlock Text="启动失败" /></Border>
              <Border Classes="badge neutral" Margin="0,0,8,0"><TextBlock Text="未运行" /></Border>
              <Border Classes="badge solidDanger"><TextBlock Text="失联" /></Border>
            </WrapPanel>

            <TextBlock Grid.Row="1" Classes="h3" Text="圆点 + 文字" VerticalAlignment="Center" />
            <WrapPanel Grid.Row="1" Grid.Column="1">
              <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,20,0">
                <Ellipse Classes="dot success" /><TextBlock Classes="note" Text="就绪" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,20,0">
                <Ellipse Classes="dot info" /><TextBlock Classes="note" Text="正在处理" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,20,0">
                <Ellipse Classes="dot warning" /><TextBlock Classes="note" Text="需要处理" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,20,0">
                <Ellipse Classes="dot danger" /><TextBlock Classes="note" Text="未配置" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Ellipse Classes="dot neutral" /><TextBlock Classes="note" Text="空闲" />
              </StackPanel>
            </WrapPanel>

            <TextBlock Grid.Row="2" Classes="h3" Text="分组标签" VerticalAlignment="Center" />
            <WrapPanel Grid.Row="2" Grid.Column="1">
              <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,14,0" VerticalAlignment="Center">
                <Ellipse Width="8" Height="8" Fill="{DynamicResource CategoryCodeStripeBrush}" VerticalAlignment="Center" />
                <TextBlock Text="主分支工作区" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource CategoryCodeFgBrush}" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,14,0" VerticalAlignment="Center">
                <Ellipse Width="8" Height="8" Fill="{DynamicResource CategoryArtStripeBrush}" VerticalAlignment="Center" />
                <TextBlock Text="发布分支工作区" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource CategoryArtFgBrush}" />
              </StackPanel>
              <Border Classes="badge neutral" Margin="0,0,8,0"><TextBlock Text="其他分组" FontWeight="Medium" /></Border>
              <TextBlock Classes="note" VerticalAlignment="Center" Text="类别用 Category* Token：无底色无描边，类别色只上在图标（实际页面为 CodeBlock / DesignIdeas），文字用对应 Fg。不做色条、色块，不用于按钮和状态。无类别含义的分组用 neutral。" TextWrapping="Wrap" MaxWidth="420" />
            </WrapPanel>

            <TextBlock Grid.Row="3" Classes="h3" Text="提示条" VerticalAlignment="Top" Margin="0,8,0,0" />
            <StackPanel Grid.Row="3" Grid.Column="1" Spacing="8">
              <Border Background="{DynamicResource InfoBgBrush}" BorderBrush="{DynamicResource InfoBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10">
                <TextBlock Classes="body" Foreground="{DynamicResource InfoFgBrush}" Text="可切换工作区或使用其他页面；完成后通知。" />
              </Border>
              <Border Background="{DynamicResource WarningBgBrush}" BorderBrush="{DynamicResource WarningBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10">
                <TextBlock Classes="body" Foreground="{DynamicResource WarningFgBrush}" Text="工具链路径与项目配置不一致，建议重新应用。" />
              </Border>
              <Border Background="{DynamicResource DangerBgBrush}" BorderBrush="{DynamicResource DangerBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10">
                <TextBlock Classes="body" Foreground="{DynamicResource DangerFgBrush}" Text="操作未完成，请检查输入后重试。" />
              </Border>
            </StackPanel>
          </Grid>
        </StackPanel>
      </Border>

      <!-- 7. 导航 + 工作区卡片 -->
      <Border Classes="section">
        <StackPanel Spacing="14">
          <StackPanel Spacing="4">
            <TextBlock Classes="h2" Text="7 · 导航选中与工作区选中" />
            <TextBlock Classes="note" Text="导航属于品牌区域，选中用 Jade 200 浅底 + Jade 700 左侧竖条（方案 A）。工作区卡片属于内容选中，归蓝色。" />
          </StackPanel>

          <Grid ColumnDefinitions="220,*" ColumnSpacing="20">
            <!-- 侧栏 -->
            <Border Background="{DynamicResource NavBgBrush}" CornerRadius="10" Padding="0,8">
              <StackPanel>
                <Border Classes="navItem selected">
                  <Grid ColumnDefinitions="Auto,*">
                    <Border Classes="indicator" Margin="-6,0,0,0" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" Margin="12,0">
                      <fi:FluentIcon Icon="Play" />
                      <TextBlock Text="工作台" />
                    </StackPanel>
                  </Grid>
                </Border>
                <Border Classes="navItem">
                  <Grid ColumnDefinitions="Auto,*">
                    <Border Classes="indicator" Margin="-6,0,0,0" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" Margin="12,0">
                      <fi:FluentIcon Icon="Desktop" />
                      <TextBlock Text="常用工具" />
                    </StackPanel>
                  </Grid>
                </Border>
                <Border Classes="navItem">
                  <Grid ColumnDefinitions="Auto,*">
                    <Border Classes="indicator" Margin="-6,0,0,0" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" Margin="12,0">
                      <fi:FluentIcon Icon="CalendarClock" />
                      <TextBlock Text="任务调度" />
                    </StackPanel>
                  </Grid>
                </Border>
                <Border Classes="navItem">
                  <Grid ColumnDefinitions="Auto,*">
                    <Border Classes="indicator" Margin="-6,0,0,0" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" Margin="12,0">
                      <fi:FluentIcon Icon="BoxMultiple" />
                      <TextBlock Text="构建产物" />
                    </StackPanel>
                  </Grid>
                </Border>
                <Border Classes="navItem">
                  <Grid ColumnDefinitions="Auto,*">
                    <Border Classes="indicator" Margin="-6,0,0,0" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" Margin="12,0">
                      <fi:FluentIcon Icon="Phone" />
                      <TextBlock Text="设备调试" />
                    </StackPanel>
                  </Grid>
                </Border>
              </StackPanel>
            </Border>

            <!-- 工作区列表 -->
            <StackPanel Grid.Column="1" Spacing="6" MaxWidth="420" HorizontalAlignment="Left">
              <Border Classes="workspaceCard">
                <StackPanel Spacing="5">
                  <Border Classes="badge neutral"><TextBlock Text="主分支工作区" FontWeight="Medium" FontSize="11" /></Border>
                  <TextBlock Text="meadow-main-build" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource FgPrimaryBrush}" />
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <Ellipse Classes="dot success" /><TextBlock Classes="meta" Text="就绪" />
                  </StackPanel>
                </StackPanel>
              </Border>
              <Border Classes="workspaceCard selected">
                <StackPanel Spacing="5">
                  <Border Classes="badge neutral"><TextBlock Text="发布分支工作区" FontWeight="Medium" FontSize="11" /></Border>
                  <TextBlock Text="meadow-release-preview" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource FgPrimaryBrush}" />
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <Ellipse Classes="dot info" /><TextBlock Classes="meta" Text="运行中 · 正在同步并校验构建产物" />
                  </StackPanel>
                </StackPanel>
              </Border>
              <Border Classes="workspaceCard">
                <StackPanel Spacing="5">
                  <Border Classes="badge neutral"><TextBlock Text="发布分支工作区" FontWeight="Medium" FontSize="11" /></Border>
                  <TextBlock Text="orchard-review-2026" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource FgPrimaryBrush}" />
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <Ellipse Classes="dot success" /><TextBlock Classes="meta" Text="就绪" />
                  </StackPanel>
                </StackPanel>
              </Border>
              <TextBlock Classes="note" Text="选中：BgSelected + BorderSelected；悬停：BgHover。名称示例已去掉公共前缀，仅作排版示意。" />
            </StackPanel>
          </Grid>
        </StackPanel>
      </Border>

      <!-- 8. 使用规则 -->
      <Border Classes="section">
        <StackPanel Spacing="12">
          <TextBlock Classes="h2" Text="8 · 使用规则" />
          <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
            <Border Background="{DynamicResource SuccessBgBrush}" BorderBrush="{DynamicResource SuccessBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
              <StackPanel Spacing="6">
                <TextBlock Classes="h3" Foreground="{DynamicResource SuccessFgBrush}" Text="应该" />
                <TextBlock Classes="body" Text="· 只引用语义 Token：{DynamicResource BorderDefaultBrush}" />
                <TextBlock Classes="body" Text="· 新增组合先在对比度表登记并确认达标" />
                <TextBlock Classes="body" Text="· 同一用途只用一个 Token，哪怕两个色值看起来差不多" />
                <TextBlock Classes="body" Text="· 浅底状态色写成具体色值 Token，为暗色模式预留" />
              </StackPanel>
            </Border>
            <Border Background="{DynamicResource DangerBgBrush}" BorderBrush="{DynamicResource DangerBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
              <StackPanel Spacing="6">
                <TextBlock Classes="h3" Foreground="{DynamicResource DangerFgBrush}" Text="不应该" />
                <TextBlock Classes="body" Text="· 在页面写 #E2E8F0 这类色值，或引用 *Color 原始色阶" />
                <TextBlock Classes="body" Text="· 用玉色表达操作或选中；用绿色做按钮" />
                <TextBlock Classes="body" Text="· 用红色表示普通入口（如打开崩溃目录）" />
                <TextBlock Classes="body" Text="· 用 Opacity 叠加生成状态浅底" />
              </StackPanel>
            </Border>
          </Grid>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
