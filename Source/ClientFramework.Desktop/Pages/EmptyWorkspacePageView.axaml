<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="using:Heron.ClientFramework.Shell"
             x:Class="Heron.ClientFramework.Shell.EmptyWorkspacePageView"
             x:DataType="shell:EmptyWorkspacePageViewModel"
             x:CompileBindings="True">
  <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
    <TextBlock Classes="textPageTitle" Text="{Binding Title}" HorizontalAlignment="Center" />
    <TextBlock Classes="textSecondary" Text="{Binding Message}" TextWrapping="Wrap" MaxWidth="680" TextAlignment="Center" />
  </StackPanel>
</UserControl>
