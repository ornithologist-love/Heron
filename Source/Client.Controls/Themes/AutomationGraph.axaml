<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fi="using:FluentIcons.Avalonia"
        xmlns:graphs="using:Heron.ClientControls.Graphs">
  <!--
    自动化流程图共享样式：正式自动化页与 Gallery 样式页共用，按类名生效，与数据类型无关。
    1. 去框架感：Stage 只保留一层浅底 + 1px 中性描边；状态由图标与文字颜色表达，
       只有「进行中 / 失败 / 待审核」改变描边颜色。并行分支用灰底描边托盘区分。
    2. 统一高度：步骤节点固定 52px，标题单行省略，第二行固定为「状态 · 补充信息」，完整内容放 Tooltip。
    3. 操作是按钮：日志、子图都是 24px 描边图标按钮；HumanGate 待审核额外提供实底「审核」主操作。
    4. 只引用语义 Token，不写死色值。
    类名：Border.graphStep / Border.graphStage 上挂 plan、pending、running、review、succeeded、failed、skipped、cancelled；
    fi|FluentIcon.stateIcon 单独挂状态类，避免 Stage 状态串到内部步骤。
    5. 派生运行：复用原运行结果的节点挂 reused（浅底、次要色标题、历史图标），等待或正在重试的节点挂 retrying（第二行暖色）；
       「从此节点重新运行」是悬停才出现的 rerun 图标按钮，不常驻占位。
  -->

  <!-- ===== 步骤节点 ===== -->
  <Style Selector="Border.graphStep">
    <Setter Property="Height" Value="52" />
    <Setter Property="MaxWidth" Value="320" />
    <Setter Property="Background" Value="{DynamicResource BgSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>
  <Style Selector="Border.graphStep:pointerover">
    <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
  </Style>
  <Style Selector="Border.graphStep.running">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="Border.graphStep.failed">
    <Setter Property="BorderBrush" Value="{DynamicResource DangerBorderBrush}" />
  </Style>
  <Style Selector="Border.graphStep.review">
    <Setter Property="Background" Value="{DynamicResource WarningBgBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource WarningIconBrush}" />
  </Style>
  <Style Selector="Border.graphStep.skipped, Border.graphStep.cancelled">
    <Setter Property="Background" Value="{DynamicResource BgSurfaceSubtleBrush}" />
  </Style>

  <Style Selector="TextBlock.stepTitle">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="LineHeight" Value="18" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{DynamicResource FgPrimaryBrush}" />
    <Setter Property="TextWrapping" Value="NoWrap" />
    <Setter Property="MaxLines" Value="1" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>
  <Style Selector="TextBlock.stepMeta">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="LineHeight" Value="16" />
    <Setter Property="Foreground" Value="{DynamicResource FgMetaBrush}" />
    <Setter Property="TextWrapping" Value="NoWrap" />
    <Setter Property="MaxLines" Value="1" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>
  <Style Selector="Border.graphStep.skipped TextBlock.stepTitle, Border.graphStep.cancelled TextBlock.stepTitle">
    <Setter Property="Foreground" Value="{DynamicResource FgSecondaryBrush}" />
  </Style>
  <Style Selector="Border.graphStep.running TextBlock.stepMeta">
    <Setter Property="Foreground" Value="{DynamicResource FgLinkBrush}" />
  </Style>
  <Style Selector="Border.graphStep.failed TextBlock.stepMeta">
    <Setter Property="Foreground" Value="{DynamicResource TextDangerBrush}" />
  </Style>
  <Style Selector="Border.graphStep.review TextBlock.stepMeta">
    <Setter Property="Foreground" Value="{DynamicResource WarningFgBrush}" />
  </Style>

  <!-- ===== 状态图标：步骤与 Stage 标题共用 ===== -->
  <Style Selector="fi|FluentIcon.stateIcon">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource FgDisabledBrush}" />
  </Style>
  <Style Selector="fi|FluentIcon.stateIcon.pending">
    <Setter Property="Foreground" Value="{DynamicResource FgMetaBrush}" />
  </Style>
  <Style Selector="fi|FluentIcon.stateIcon.running">
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    <Setter Property="RenderTransform" Value="rotate(0deg)" />
    <Style.Animations>
      <Animation Duration="0:0:1.4" IterationCount="INFINITE">
        <KeyFrame Cue="0%"><Setter Property="RotateTransform.Angle" Value="0" /></KeyFrame>
        <KeyFrame Cue="100%"><Setter Property="RotateTransform.Angle" Value="360" /></KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>
  <Style Selector="fi|FluentIcon.stateIcon.succeeded">
    <Setter Property="Foreground" Value="{DynamicResource SuccessIconBrush}" />
  </Style>
  <Style Selector="fi|FluentIcon.stateIcon.failed">
    <Setter Property="Foreground" Value="{DynamicResource DangerIconBrush}" />
  </Style>
  <Style Selector="fi|FluentIcon.stateIcon.cancelled">
    <Setter Property="Foreground" Value="{DynamicResource WarningIconBrush}" />
  </Style>
  <Style Selector="fi|FluentIcon.stateIcon.review">
    <Setter Property="Foreground" Value="{DynamicResource WarningFgBrush}" />
  </Style>

  <!-- 派生运行：复用的节点没有在本次执行，弱化为浅底；重试中的节点第二行用暖色提示上次失败 -->
  <Style Selector="Border.graphStep.reused">
    <Setter Property="Background" Value="{DynamicResource BgSurfaceSubtleBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
  </Style>
  <Style Selector="Border.graphStep.reused TextBlock.stepTitle">
    <Setter Property="Foreground" Value="{DynamicResource FgSecondaryBrush}" />
  </Style>
  <Style Selector="fi|FluentIcon.stateIcon.reused">
    <Setter Property="Foreground" Value="{DynamicResource FgMetaBrush}" />
  </Style>
  <Style Selector="Border.graphStep.retrying TextBlock.stepMeta">
    <Setter Property="Foreground" Value="{DynamicResource WarningFgBrush}" />
  </Style>

  <!-- 运行进度：贴底 2px，不占布局高度 -->
  <Style Selector="ProgressBar.stepProgress">
    <Setter Property="Height" Value="2" />
    <Setter Property="MinHeight" Value="2" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="VerticalAlignment" Value="Bottom" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
  </Style>

  <!-- ===== 节点操作按钮：审核 / 子图 / 日志 ===== -->
  <Style Selector="Button.graphAction">
    <Setter Property="Height" Value="24" />
    <Setter Property="MinHeight" Value="24" />
    <Setter Property="MinWidth" Value="24" />
    <Setter Property="Padding" Value="6,0" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.graphAction.iconOnly">
    <Setter Property="Width" Value="24" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="Button.graphAction /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BgSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource FgSecondaryBrush}" />
  </Style>
  <Style Selector="Button.graphAction:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BgHoverBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource FgPrimaryBrush}" />
  </Style>
  <Style Selector="Button.graphAction:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BgPressedBrush}" />
  </Style>
  <Style Selector="Button.graphAction:focus-visible /template/ ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource BorderFocusBrush}" />
  </Style>
  <Style Selector="Button.graphAction fi|FluentIcon">
    <Setter Property="Width" Value="14" />
    <Setter Property="Height" Value="14" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{Binding $parent[Button].Foreground}" />
  </Style>
  <!-- 从此节点重新运行：只在悬停或键盘聚焦时出现，避免每个节点常驻一个按钮 -->
  <Style Selector="Border.graphStep Button.graphAction.rerun">
    <Setter Property="Opacity" Value="0" />
  </Style>
  <Style Selector="Border.graphStep:pointerover Button.graphAction.rerun, Border.graphStep Button.graphAction.rerun:focus-within">
    <Setter Property="Opacity" Value="1" />
  </Style>
  <!-- 重试：挂在失败或取消的节点上，常驻显示；从失败处继续，已完成步骤复用原结果 -->
  <Style Selector="Button.graphAction.retry /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource DangerBgBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DangerBorderBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextDangerBrush}" />
  </Style>
  <Style Selector="Button.graphAction.retry:pointerover /template/ ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource TextDangerBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextDangerBrush}" />
  </Style>
  <Style Selector="Button.graphAction.retry:disabled /template/ ContentPresenter">
    <Setter Property="Opacity" Value="0.5" />
  </Style>
  <!-- 审核：HumanGate 唯一的主操作，实底暖色，与日志/子图的描边按钮区分 -->
  <Style Selector="Button.graphAction.review /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource WarningSolidBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource WarningSolidBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource BgSurfaceBrush}" />
  </Style>
  <Style Selector="Button.graphAction.review:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource WarningFgBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource WarningFgBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource BgSurfaceBrush}" />
    <Setter Property="Opacity" Value="0.88" />
  </Style>

  <!-- ===== Stage ===== -->
  <Style Selector="Border.graphStage">
    <Setter Property="Background" Value="{DynamicResource BgSurfaceSubtleBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style Selector="Border.graphStage.running">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="Border.graphStage.failed">
    <Setter Property="BorderBrush" Value="{DynamicResource DangerBorderBrush}" />
  </Style>
  <Style Selector="Border.graphStage.review">
    <Setter Property="BorderBrush" Value="{DynamicResource WarningIconBrush}" />
  </Style>
  <Style Selector="TextBlock.stageTitle">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="LineHeight" Value="18" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource FgPrimaryBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="TextWrapping" Value="NoWrap" />
    <Setter Property="MaxLines" Value="1" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>
  <Style Selector="TextBlock.stageTitle.skipped, TextBlock.stageTitle.cancelled">
    <Setter Property="Foreground" Value="{DynamicResource FgSecondaryBrush}" />
  </Style>
  <Style Selector="TextBlock.stageState">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource FgMetaBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.stageState.running">
    <Setter Property="Foreground" Value="{DynamicResource FgLinkBrush}" />
  </Style>
  <Style Selector="TextBlock.stageState.failed">
    <Setter Property="Foreground" Value="{DynamicResource TextDangerBrush}" />
  </Style>
  <Style Selector="TextBlock.stageState.review">
    <Setter Property="Foreground" Value="{DynamicResource WarningFgBrush}" />
  </Style>
  <Style Selector="Border.graphChip">
    <Setter Property="Height" Value="20" />
    <Setter Property="Padding" Value="6,0" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Background" Value="{DynamicResource NeutralStatusBgBrush}" />
  </Style>
  <Style Selector="Border.graphChip > TextBlock">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource NeutralStatusFgBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- ===== 派生运行：运行概要中的来源 / 派生链接与确认面板 ===== -->
  <Style Selector="Border.lineageChip">
    <Setter Property="Height" Value="22" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="CornerRadius" Value="11" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
  </Style>
  <Style Selector="Border.lineageChip TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource FgLinkBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.lineageChip fi|FluentIcon">
    <Setter Property="Foreground" Value="{DynamicResource FgLinkBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.reexecutionConfirm">
    <Setter Property="Padding" Value="14,12" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Background" Value="{DynamicResource BgSurfaceSubtleBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}" />
  </Style>
  <Style Selector="Border.reexecutionConfirm.blocked">
    <Setter Property="Background" Value="{DynamicResource DangerBgBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DangerBorderBrush}" />
  </Style>

  <!-- 横向主图与 Stage 内纵向图：统一连线、并行托盘配色 -->
  <Style Selector="graphs|DependencyGraphPanel.automationLane">
    <Setter Property="Orientation" Value="Horizontal" />
    <Setter Property="NodeWidth" Value="236" />
    <Setter Property="MaxNodeWidth" Value="320" />
    <Setter Property="NodeSpacing" Value="28" />
    <Setter Property="FitNodeWidths" Value="True" />
    <Setter Property="ConnectorBrush" Value="{DynamicResource BorderStrongBrush}" />
    <Setter Property="ConnectorThickness" Value="1" />
    <Setter Property="ConditionalBrush" Value="{DynamicResource BorderStrongBrush}" />
    <Setter Property="ConnectorAnchorY" Value="20" />
  </Style>
  <Style Selector="graphs|DependencyGraphPanel.automationStage">
    <Setter Property="Orientation" Value="Vertical" />
    <Setter Property="NodeWidth" Value="236" />
    <Setter Property="MaxNodeWidth" Value="236" />
    <Setter Property="NodeSpacing" Value="8" />
    <Setter Property="StretchNodes" Value="True" />
    <Setter Property="StackBranches" Value="True" />
    <Setter Property="ConnectorBrush" Value="{DynamicResource BorderStrongBrush}" />
    <Setter Property="ConnectorThickness" Value="1" />
    <Setter Property="BranchBackground" Value="{DynamicResource BgPressedBrush}" />
    <Setter Property="BranchBorderBrush" Value="{DynamicResource BorderStrongBrush}" />
    <Setter Property="BranchCornerRadius" Value="6" />
  </Style>
</Styles>
