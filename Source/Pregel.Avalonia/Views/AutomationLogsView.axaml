<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Heron.Pregel.Avalonia.ViewModels"
             xmlns:views="using:Heron.Pregel.Avalonia.Views"
             xmlns:fi="using:FluentIcons.Avalonia"
             x:Class="Heron.Pregel.Avalonia.Views.AutomationLogsView"
             x:DataType="vm:AutomationLogsViewModel">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://AvaloniaEdit/Themes/Base.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>
  <UserControl.Styles>
    <Style Selector="Button.logIcon">
      <Setter Property="Width" Value="28" />
      <Setter Property="Height" Value="28" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="Padding" Value="4" />
    </Style>
  </UserControl.Styles>
  <Grid RowDefinitions="Auto,*,Auto" Background="{DynamicResource BgSurfaceBrush}">
    <Border Padding="12,8" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,1">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <TextBlock Classes="textSecondary" Text="{Binding SelectedScope.Title}" VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding SelectedScope.Title}" />
        <Border Grid.Column="1" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="5">
          <Grid ColumnDefinitions="*,Auto,Auto,Auto" Width="300" Height="30">
            <TextBox x:Name="SearchBox" PlaceholderText="搜索日志（Ctrl+F）" BorderThickness="0" Background="Transparent"
                     MinHeight="0" Padding="8,4" FontSize="12" TextChanged="Search_TextChanged" KeyDown="Search_KeyDown"
                     ToolTip.Tip="搜索当前已加载内容；Enter 下一处，Shift+Enter 上一处" />
            <TextBlock Grid.Column="1" x:Name="SearchCount" Classes="textMeta" Margin="4,0" VerticalAlignment="Center" />
            <Button Grid.Column="2" x:Name="PreviousMatch" Classes="contentButton buttonQuiet logIcon" IsEnabled="False"
                    Click="PreviousMatch_Click" ToolTip.Tip="上一处（Shift+Enter）" AutomationProperties.Name="上一处匹配">
              <fi:FluentIcon Icon="ChevronUp" IconSize="Size16" />
            </Button>
            <Button Grid.Column="3" x:Name="NextMatch" Classes="contentButton buttonQuiet logIcon" IsEnabled="False"
                    Click="NextMatch_Click" ToolTip.Tip="下一处（Enter）" AutomationProperties.Name="下一处匹配">
              <fi:FluentIcon Icon="ChevronDown" IconSize="Size16" />
            </Button>
          </Grid>
        </Border>
      </Grid>
    </Border>
    <Grid Grid.Row="1" Margin="12,10,8,6">
      <views:AutomationArtifactCodeView x:Name="LogEditor" Document="{Binding Document}"
                                       ShowLineNumbers="False" WordWrap="False" FontSize="12"
                                       HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" />
      <Button x:Name="BackToLatest" Classes="contentButton buttonSecondary buttonSmall" IsVisible="False"
              Content="↓ 回到最新" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,16,20"
              Click="BackToLatest_Click" ToolTip.Tip="回到底部，继续跟随新日志" />
    </Grid>
    <Border Grid.Row="2" Padding="12,5" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <TextBlock Classes="textMeta" Text="{Binding Notice}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Notice}" />
        <TextBlock Grid.Column="1" Classes="textMeta" Text="{Binding RangeText}" />
      </Grid>
    </Border>
  </Grid>
</UserControl>