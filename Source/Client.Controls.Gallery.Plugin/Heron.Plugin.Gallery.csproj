<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Example client plugin: the control Gallery as one page. The package folder is the build output:
    plugin.json + this assembly + private dependencies. Framework contracts are shared by the host and are
    never copied into the package (Private=false).
  -->
  <PropertyGroup>
    <AssemblyName>Heron.Plugin.Gallery</AssemblyName>
    <RootNamespace>Heron.Plugins.Gallery</RootNamespace>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <PluginId>heron.gallery</PluginId>
    <PluginHostApi>4</PluginHostApi>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>$(MSBuildThisFileDirectory)../../../Binaries/Heron/Plugins/$(PluginId)/$(Version)/</OutputPath>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../ClientFramework.Abstractions/Heron.ClientFramework.Abstractions.csproj" Private="false" />
    <ProjectReference Include="../ClientFramework.Plugins/Heron.ClientFramework.Plugins.csproj" Private="false" />
    <ProjectReference Include="../Client.Controls/Heron.ClientControls.csproj" Private="false" />
    <PackageReference Include="CommunityToolkit.Mvvm" ExcludeAssets="runtime" />
    <PackageReference Include="Avalonia" ExcludeAssets="runtime" />
    <PackageReference Include="Avalonia.Controls.DataGrid" ExcludeAssets="runtime" />
    <PackageReference Include="FluentIcons.Avalonia" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" ExcludeAssets="runtime" />
  </ItemGroup>
  <!-- The Gallery views compile into the plugin, so the page needs no standalone executable or desktop runtime. -->
  <PropertyGroup>
    <GallerySource>$(MSBuildThisFileDirectory)../Client.Controls.Gallery/</GallerySource>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- Headless pointer simulation is for the standalone capture only. -->
    <DefineConstants>$(DefineConstants);GALLERY_PLUGIN</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(GallerySource)GalleryCatalog.cs;$(GallerySource)GalleryView.axaml.cs;$(GallerySource)Pages/**/*.cs" LinkBase="Gallery" />
    <AvaloniaXaml Include="$(GallerySource)GalleryView.axaml;$(GallerySource)Pages/**/*.axaml" LinkBase="Gallery" />
  </ItemGroup>
  <!-- The manifest carries the same version as the package folder. -->
  <Target Name="WritePluginManifest" AfterTargets="Build">
    <WriteLinesToFile File="$(OutputPath)plugin.json" Overwrite="true" WriteOnlyWhenDifferent="true" Lines="{
  &quot;schema_version&quot;: 1,
  &quot;id&quot;: &quot;$(PluginId)&quot;,
  &quot;display_name&quot;: &quot;控件 Gallery&quot;,
  &quot;version&quot;: &quot;$(Version)&quot;,
  &quot;host_api&quot;: &quot;$(PluginHostApi)&quot;,
  &quot;update_mode&quot;: &quot;restart_required&quot;,
  &quot;modules&quot;: [
    {
      &quot;name&quot;: &quot;Gallery&quot;,
      &quot;assembly&quot;: &quot;$(AssemblyName).dll&quot;,
      &quot;entry_type&quot;: &quot;Heron.Plugins.Gallery.GalleryModule&quot;,
      &quot;load&quot;: &quot;startup&quot;
    }
  ]
}" />
  </Target>
</Project>
