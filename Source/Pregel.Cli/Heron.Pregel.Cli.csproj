<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Heron.Pregel.Cli</PackageId>
    <AssemblyName>Heron.Pregel.Cli</AssemblyName>
    <RootNamespace>Heron.Pregel.Cli</RootNamespace>
    <IsPackable>true</IsPackable>
    <Description>Reusable durable graph execution: Pregel.Cli.</Description>
    <OutputType>Exe</OutputType>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>heron-pregel</ToolCommandName>
    <BaseOutputPath>$(MSBuildThisFileDirectory)../../../Binaries/Heron/Pregel.Cli/</BaseOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Pregel.Automation/Heron.Pregel.Automation.csproj" />
    <EmbeddedResource Include="../Pregel/**/*.cs" Exclude="../Pregel/obj/**;../Pregel/bin/**" LogicalName="api/Heron.Pregel/%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="../Pregel.Automation/**/*.cs" Exclude="../Pregel.Automation/obj/**;../Pregel.Automation/bin/**" LogicalName="api/Heron.Pregel.Automation/%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../Skills/heron-pregel/**/*" LogicalName="skill/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
